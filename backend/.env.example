# Server
PORT=8300
NODE_ENV=development
LOG_LEVEL=debug

# FortiManager connection
FMG_HOST=fmg.example.com
FMG_PORT=443
FMG_USER=apiuser
FMG_PASSWORD=changeme
FMG_VERIFY_TLS=false
FMG_DEFAULT_ADOM=root

# Supabase (server-side)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Set to true to run without a live FMG (uses fixture data).
# Set to false once FMG_* is reachable.
USE_MOCK_DATA=true

# Skip auth entirely in local dev (bypasses Supabase JWT check).
# Never set this to true in production.
DEV_SKIP_AUTH=true

# Demo deployment flag. When true, forces mock data, skips auth, and
# rejects every non-GET request. Use this for public demo deployments
# such as fmg.tannerharrison.com.
DEMO_MODE=false

# CORS origin for the frontend in dev
CORS_ORIGIN=http://localhost:5173
